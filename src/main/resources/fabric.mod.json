{
	"schemaVersion": 1,
	"id": "linearxpfabric",
	"version": "${version}",
	"name": "LinearXpFabric",
	"description": "Makes it the same amount of XP required to increase the XP level for each level.\n\nThe amount of experience required to upgrade can be modified in Profile linearxpfabric.json, which defaults to 50.",
	"authors": [
		"Flechazo"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/linearxpfabric/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.flechazo.LinearXpFabric"
		]
	},
	"mixins": [
		"linearxpfabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}